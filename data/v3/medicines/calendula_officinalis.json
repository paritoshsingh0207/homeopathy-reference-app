denceRef":"cc0271711ef50f1416be1bb6","weight":1.0,"confidence":0.96}],"sections":[{"source":"04_boericke_materia_medica","section":"head","label":"Head","startLine":8208,"endLine":8211,"text":"Extremely nervous; tearing headache;\nweight on brain. Submaxillary glands swollen, painful\nto touch. Pain in right side of neck."},{"source":"04_boericke_materia_medica","section":"eyes","label":"Eyes","startLine":8212,"endLine":8221,"text":"Injuries to eyes which tend to suppuration;\nafter operations; blenoirhcea of lachrymal sac.\n\nEkirs. — Deafness; worse in damp surroundings and\nVtrith eczematous conditions. Hears best on a train,\nand distant sounds.\n\n\n181"},{"source":"04_boericke_materia_medica","section":"nose","label":"Nose","startLine":8222,"endLine":8224,"text":"Coryza in one nostril; with much green dis-\ncharge."},{"source":"04_boericke_materia_medica","section":"stomach","label":"Stomach","startLine":8225,"endLine":8226,"text":"Hunger immediately after nursing.\nBulimy. Heartburn with horripilations. Nausea in"},{"source":"04_boericke_materia_medica","section":"chest","label":"chest","startLine":8227,"endLine":8229,"text":"Vomiting. Sinking sensation. Epigastric dis~\ntention."},{"source":"04_boericke_materia_medica","section":"respiratory","label":"Respiratory","startLine":8230,"endLine":8232,"text":"Cough, with green expectoration,\nhoarseness; with distention of inguinal ring."},{"source":"04_boericke_materia_medica","section":"female","label":"Female","startLine":8233,"endLine":8238,"text":"Warts at the os externum. Menses sup-\npressed, with cough. Chronic endocervicitis. Uterine\nhypertrophy, sensation of weight and fullness in pelvis;\nstretching and dragging in groin ; pain on sudden move-\nments. Os lower than natural. Menorrhagia."},{"source":"04_boericke_materia_medica","section":"skin","label":"Skin","startLine":8239,"endLine":8242,"text":"Yellow; goose-flesh. Promotes favorable\ncicatrization, with least amount of suppuration. Slough,\nproud flesh, and raised edges."},{"source":"04_boericke_materia_medica","section":"fever","label":"Fever","startLine":8243,"endLine":8246,"text":"Coldness, great sensitiveness to open air;\nshuddering in back, skin feels warm to touch. Heat\nin evening."},{"source":"04_boericke_materia_medica","section":"modalities","label":"Modalities","startLine":8247,"endLine":8248,"text":"Worse, in damp, jhf^avy, cloudy weather."},{"source":"04_boericke_materia_medica","section":"relationship","label":"Relationship","startLine":8249,"endLine":8258,"text":"Compare: Hamamel.; Hyperic.;\nSymph.; Arn.\n\nCompare in deafness: Ferr. pic.; Kal. iod.; Calc.;\nMag. c.; Graph.\n\nA.ntidote: Chelidon.; Rheum.\n\nComplementary : Hepar."}],"corpusPassages":[{"source":"corpus_aa7e2fa5c089","passageId":"pass_f9fd13067ac4073c687c","ordinal":53,"text":"Belladonna Bryonia alb Cactus grandiflorus Calcarea carbonica Calcarea phospborica Calendula officinalis Cantbaris Carbo vegetabilis Caulopbyllum Causticum"}]}